{
  "name": "telegram-link-bot",
  "description": "Telegram Bot to manage links and broadcast messages",
  "keywords": ["telegram", "bot", "broadcast", "links"],
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram ID as owner",
      "required": true
    },
    "CHANNEL_USERNAME": {
      "description": "Your Telegram channel username (without @)",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
